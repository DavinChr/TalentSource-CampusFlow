# =============================================================================
# CampusFlow Environment Configuration
# =============================================================================

# Google Gemini API Key
GEMINI_API_KEY=

# Model yang digunakan (Default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Tanggal Simulasi Sistem (Time Travel Mock)
# Kosongkan atau komentari jika ingin menggunakan tanggal asli jam sistem komputer.
# Set ke 2026-09-21 jika ingin menguji skenario benchmark SRS (TC-01 s/d TC-10).
SIMULATED_TODAY=2026-09-21

# Standarisasi Kode Departemen Notifikasi
NOTIFICATION_IT_DEPT=it_support
